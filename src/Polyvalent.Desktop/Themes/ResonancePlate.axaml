<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="Background" Value="#090A0E" />
    <Setter Property="Foreground" Value="#E7E1D6" />
    <Setter Property="FontFamily" Value="Inter" />
  </Style>

  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#A78BFA" />
    <Setter Property="LetterSpacing" Value="2" />
  </Style>

  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="Georgia" />
    <Setter Property="Foreground" Value="#F1E8D7" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="monospace" />
    <Setter Property="Foreground" Value="#A7ABB8" />
  </Style>

  <Style Selector="Border.plate">
    <Setter Property="Background" Value="#111319" />
    <Setter Property="BorderBrush" Value="#292D39" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.inset">
    <Setter Property="Background" Value="#0C0E13" />
    <Setter Property="BorderBrush" Value="#242735" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="10" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Background" Value="#1B1E27" />
    <Setter Property="Foreground" Value="#E7E1D6" />
    <Setter Property="BorderBrush" Value="#414655" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="12,7" />
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#29243A" />
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Background" Value="#3A2534" />
    <Setter Property="BorderBrush" Value="#B85C73" />
    <Setter Property="Foreground" Value="#FFD8C8" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="#0B0D12" />
    <Setter Property="Foreground" Value="#EEE7DA" />
    <Setter Property="BorderBrush" Value="#343846" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style Selector="Expander">
    <Setter Property="Background" Value="Transparent" />
  </Style>
</Styles>
