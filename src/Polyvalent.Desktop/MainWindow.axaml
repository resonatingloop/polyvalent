<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Polyvalent.Desktop.ViewModels"
        xmlns:app="using:Polyvalent.Application"
        xmlns:domain="using:Polyvalent.Domain"
        x:Class="Polyvalent.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="polyvalent · private research ledger"
        Width="1380"
        Height="880"
        MinWidth="1060"
        MinHeight="700">
  <Grid RowDefinitions="54,*,34">
    <Border Grid.Row="0" Background="#0C0D12" BorderBrush="#2B2E38" BorderThickness="0,0,0,1">
      <Grid Margin="20,0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Classes="display" FontSize="22" Text="polyvalent" />
          <TextBlock Classes="eyebrow" VerticalAlignment="Center" Text="PRIVATE RELATIONAL CABINET" />
        </StackPanel>
        <TextBlock Grid.Column="2" Classes="mono" FontSize="11" Text="{Binding StagingMessage}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="16" ColumnDefinitions="236,12,*,12,344">
      <Border Grid.Column="0" Classes="plate">
        <Grid RowDefinitions="Auto,Auto,18,Auto,*,Auto">
          <TextBlock Classes="eyebrow" Text="OPEN AN INTEGER" />
          <Grid Grid.Row="1" Margin="0,10,0,0" ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding SearchText}" PlaceholderText="canonical integer" AutomationProperties.Name="integer search" />
            <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding OpenCommand}" Content="open" />
          </Grid>
          <Grid Grid.Row="3" ColumnDefinitions="*,8,*">
            <Button Command="{Binding PreviousCommand}" Content="← prior" />
            <Button Grid.Column="2" Command="{Binding NextCommand}" Content="next →" />
          </Grid>
          <ScrollViewer Grid.Row="4"
                        Margin="0,22,0,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="eyebrow" Text="HELD IN THIS ROOM" />
                <Button Grid.Column="1" Command="{Binding HoldActiveCommand}" Content="+ hold" />
              </Grid>
              <ListBox ItemsSource="{Binding HeldObjects}" SelectedItem="{Binding SelectedHeldObject}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="app:ResearchObjectRef">
                    <Border Classes="inset" Padding="9" Margin="0,0,0,5">
                      <StackPanel>
                        <TextBlock Classes="eyebrow" Text="{Binding TypeLabel}" />
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Label}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid ColumnDefinitions="*,8,*">
                <Button Command="{Binding OpenHeldCommand}" Content="return" />
                <Button Grid.Column="2" Command="{Binding RemoveHeldCommand}" Content="release" />
              </Grid>
              <Border Height="1" Background="#2D303B" Margin="0,8" />
              <TextBlock Classes="eyebrow" Text="VISIT TRAIL / SESSION ONLY" />
              <ItemsControl ItemsSource="{Binding VisitTrail}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="app:ResearchObjectRef">
                    <TextBlock Classes="mono" FontSize="10" Margin="0,2" TextWrapping="Wrap" Text="{Binding Label}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,8,*">
                <Button Command="{Binding TrailBackCommand}" Content="← back" />
                <Button Grid.Column="2" Command="{Binding TrailForwardCommand}" Content="forward →" />
              </Grid>
            </StackPanel>
          </ScrollViewer>
          <Border Grid.Row="5" Classes="inset" Padding="8" Margin="0,10,0,0">
            <StackPanel Spacing="5">
              <TextBlock Classes="eyebrow"
                         Focusable="True"
                         AutomationProperties.Name="{Binding LedgerOrientationLabel}"
                         Text="{Binding LedgerOrientationLabel}"
                         TextWrapping="Wrap" />
              <TextBlock Classes="mono" FontSize="9" TextWrapping="Wrap" Text="{Binding DatabasePath}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="plate" Padding="22">
        <Grid RowDefinitions="Auto,18,*">
          <Grid RowDefinitions="Auto,Auto">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Classes="eyebrow" Text="RESEARCH OBJECT / ACTIVE RECORD" />
                <TextBlock Classes="mono" FontSize="11" Foreground="#A78BFA" Text="{Binding ActiveObjectSubtitle}" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                <TextBlock Classes="mono" FontSize="10" HorizontalAlignment="Right" Text="ONE ROOM / THREE OCCUPANTS" />
                <TextBlock Foreground="#7FC9A5" HorizontalAlignment="Right" Text="identity · company · warrant" />
              </StackPanel>
            </Grid>
            <TextBlock Grid.Row="1" Classes="display" FontSize="58" LineHeight="60" TextWrapping="Wrap" Text="{Binding ActiveObjectTitle}" />
          </Grid>

          <ScrollViewer Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalContentAlignment="Stretch">
            <Grid>
            <StackPanel IsVisible="{Binding IsIntegerActive}" HorizontalAlignment="Stretch" Spacing="12">
              <Expander HorizontalAlignment="Stretch" IsExpanded="True" Header="property states &amp; evidence">
                <ListBox ItemsSource="{Binding Claims}" SelectedItem="{Binding SelectedClaim}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="app:ClaimView">
                      <Border Classes="inset">
                        <StackPanel Spacing="7">
                          <Grid ColumnDefinitions="210,*,Auto">
                            <StackPanel>
                              <TextBlock FontWeight="SemiBold" Text="{Binding PropertyName}" TextWrapping="Wrap" />
                              <TextBlock Classes="mono" FontSize="10" Text="{Binding PropertySlug}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0">
                              <TextBlock Text="{Binding Witness.DisplayText}" TextWrapping="Wrap" />
                              <TextBlock Classes="mono" FontSize="10" Text="{Binding QualifierJson}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                              <TextBlock Foreground="#D39A72" HorizontalAlignment="Right" Text="{Binding State}" />
                              <TextBlock Classes="mono" FontSize="10" HorizontalAlignment="Right" Text="{Binding RevisionStatus}" />
                              <TextBlock Classes="mono" FontSize="10" HorizontalAlignment="Right" Text="{Binding Origin}" />
                              <TextBlock Classes="mono" FontSize="9" HorizontalAlignment="Right" Foreground="#A78BFA" Text="{Binding StagingLabel}" />
                            </StackPanel>
                          </Grid>
                          <TextBlock Classes="mono" FontSize="10" Foreground="#8E91A0" Text="{Binding PrivateNotes}" TextWrapping="Wrap" />
                          <ItemsControl ItemsSource="{Binding Citations}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="app:CitationView">
                                <Grid Margin="0,2,0,0" ColumnDefinitions="*,Auto">
                                  <StackPanel>
                                    <TextBlock FontSize="11" Text="{Binding Label}" TextWrapping="Wrap" />
                                    <TextBlock Classes="mono" FontSize="9" Foreground="#79B9AD" Text="{Binding Url}" TextWrapping="Wrap" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right">
                                    <TextBlock Classes="mono" FontSize="9" HorizontalAlignment="Right" Text="{Binding Role}" />
                                    <TextBlock Classes="mono" FontSize="9" Foreground="#A78BFA" HorizontalAlignment="Right" Text="{Binding PublicationLabel}" />
                                  </StackPanel>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Expander>

              <Expander HorizontalAlignment="Stretch" IsExpanded="True" Header="authored direct relations">
                <StackPanel Spacing="8">
                  <ListBox ItemsSource="{Binding DirectRelations}" SelectedItem="{Binding SelectedDirectRelation}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="app:DirectRelationView">
                        <Border Classes="inset">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                              <TextBlock Classes="display" FontSize="20" TextWrapping="Wrap" Text="{Binding Proposition}" />
                              <TextBlock Classes="mono" FontSize="10" Text="{Binding ParticipantLine}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                              <TextBlock Classes="eyebrow" Text="{Binding DirectionalityLabel}" />
                              <TextBlock Classes="mono" FontSize="10" Text="{Binding ActiveLabel}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Button HorizontalAlignment="Left" Command="{Binding OpenSelectedDirectRelationCommand}" Content="open selected relation →" />
                </StackPanel>
              </Expander>

              <Expander HorizontalAlignment="Stretch" IsExpanded="True" Header="constellation memberships">
                <StackPanel Spacing="8">
                  <ListBox ItemsSource="{Binding Constellations}" SelectedItem="{Binding SelectedConstellation}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="app:ConstellationView">
                        <Border Classes="inset">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                              <TextBlock Classes="display" FontSize="20" TextWrapping="Wrap" Text="{Binding Name}" />
                              <TextBlock Classes="mono" FontSize="10" Text="{Binding MemberLine}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Classes="mono" FontSize="10" Margin="14,0,0,0" Text="{Binding ActiveLabel}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Button HorizontalAlignment="Left" Command="{Binding OpenSelectedConstellationCommand}" Content="open selected constellation →" />
                </StackPanel>
              </Expander>

              <Expander HorizontalAlignment="Stretch" IsExpanded="True" Header="profile entries / contextual lore">
                <ListBox ItemsSource="{Binding ProfileEntries}" SelectedItem="{Binding SelectedProfile}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="app:ProfileEntryView">
                      <Border Classes="inset">
                        <StackPanel Spacing="5">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="display" FontSize="20" Text="{Binding Title}" />
                            <TextBlock Grid.Column="1" Classes="mono" FontSize="10" Text="{Binding Status}" />
                          </Grid>
                          <TextBlock Foreground="#A78BFA" Text="{Binding Category}" />
                          <TextBlock TextWrapping="Wrap" Text="{Binding Body}" />
                          <TextBlock Classes="mono" FontSize="10" Text="{Binding EpistemicRegister}" />
                          <TextBlock Classes="mono" FontSize="10" Foreground="#8E91A0" Text="{Binding PrivateNotes}" TextWrapping="Wrap" />
                          <TextBlock Classes="mono" FontSize="9" Foreground="#A78BFA" Text="{Binding StagingLabel}" />
                          <ItemsControl ItemsSource="{Binding Citations}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="app:CitationView">
                                <Grid Margin="0,2,0,0" ColumnDefinitions="*,Auto">
                                  <StackPanel>
                                    <TextBlock FontSize="11" Text="{Binding Label}" TextWrapping="Wrap" />
                                    <TextBlock Classes="mono" FontSize="9" Foreground="#79B9AD" Text="{Binding Url}" TextWrapping="Wrap" />
                                  </StackPanel>
                                  <TextBlock Grid.Column="1" Classes="mono" FontSize="9" Margin="12,0,0,0" Foreground="#A78BFA" Text="{Binding PublicationLabel}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Expander>

              <Expander HorizontalAlignment="Stretch" Header="selected revision operations">
                <Border Classes="inset">
                  <StackPanel Spacing="9">
                    <TextBlock Classes="eyebrow" Text="CLAIM REVISION" />
                    <WrapPanel Orientation="Horizontal">
                      <Button Margin="0,0,7,7" Command="{Binding AcceptSelectedClaimCommand}" Content="accept draft" />
                      <Button Margin="0,0,7,7" Command="{Binding WithdrawSelectedClaimCommand}" Content="withdraw draft" />
                      <Button Classes="accent" Margin="0,0,7,7" Command="{Binding StageSelectedClaimCommand}" Content="stage exact claim" />
                    </WrapPanel>
                    <TextBlock Classes="eyebrow" Margin="0,8,0,0" Text="PROFILE REVISION" />
                    <WrapPanel Orientation="Horizontal">
                      <Button Margin="0,0,7,7" Command="{Binding PrepareProfileRevisionCommand}" Content="revise into draft" />
                      <Button Margin="0,0,7,7" Command="{Binding AcceptSelectedProfileCommand}" Content="accept draft" />
                      <Button Margin="0,0,7,7" Command="{Binding WithdrawSelectedProfileCommand}" Content="withdraw draft" />
                      <Button Classes="accent" Margin="0,0,7,7" Command="{Binding StageSelectedProfileCommand}" Content="stage exact profile" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </Expander>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsDirectRelationActive}" Spacing="16">
              <Border Classes="inset" Padding="22">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="eyebrow" Text="AUTHORED PROPOSITION" />
                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding ActiveDirectRelation.ActiveLabel}" />
                  </Grid>
                  <TextBlock Classes="display" FontSize="34" TextWrapping="Wrap" Text="{Binding ActiveDirectRelation.Proposition}" />
                  <ListBox ItemsSource="{Binding ActiveDirectRelation.Participants}" SelectedItem="{Binding SelectedDirectRelationParticipant}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="domain:DirectRelationParticipant">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                          <TextBlock Classes="display" FontSize="26" Text="{Binding Integer}" />
                          <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Text="{Binding Role}" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Button HorizontalAlignment="Left" Command="{Binding OpenSelectedDirectRelationParticipantCommand}" Content="open selected integer →" />
                </StackPanel>
              </Border>
              <Border Classes="inset" Padding="22">
                <StackPanel Spacing="10">
                  <TextBlock Classes="eyebrow" Text="WARRANT" />
                  <TextBlock FontSize="17" TextWrapping="Wrap" Text="{Binding ActiveDirectRelation.Warrant}" />
                  <TextBlock Classes="eyebrow" Margin="0,12,0,0" Text="PRIVATE NOTE" />
                  <TextBlock Classes="mono" TextWrapping="Wrap" Foreground="#8E91A0" Text="{Binding ActiveDirectRelation.PrivateNotes}" />
                </StackPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding ActiveDirectRelation.Citations}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="app:AuthoredCitationView">
                    <Border Classes="inset" Margin="0,0,0,7">
                      <StackPanel Spacing="3">
                        <TextBlock FontWeight="SemiBold" Text="{Binding SourceTitle}" />
                        <TextBlock Text="{Binding Label}" />
                        <TextBlock Classes="mono" FontSize="10" Text="{Binding Role}" />
                        <TextBlock Classes="mono" FontSize="10" Text="{Binding Locator}" />
                        <TextBlock Classes="mono" FontSize="10" Text="{Binding SourceCaptureId}" />
                        <TextBlock Classes="mono" FontSize="10" Foreground="#79B9AD" TextWrapping="Wrap" Text="{Binding SourceUrl}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsConstellationActive}" Spacing="16">
              <Border Classes="inset" Padding="22">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="eyebrow" Text="AUTHORED COMPANY" />
                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding ActiveConstellation.ActiveLabel}" />
                  </Grid>
                  <TextBlock Classes="display" FontSize="34" TextWrapping="Wrap" Text="{Binding ActiveConstellation.Name}" />
                  <TextBlock FontSize="17" TextWrapping="Wrap" Text="{Binding ActiveConstellation.Account}" />
                </StackPanel>
              </Border>
              <ListBox ItemsSource="{Binding ActiveConstellation.Members}" SelectedItem="{Binding SelectedConstellationMember}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="domain:ConstellationMember">
                    <Border Classes="inset" Margin="0,0,0,7">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Classes="display" FontSize="28" Text="{Binding Integer}" />
                        <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Text="{Binding Role}" />
                        <TextBlock Grid.Column="2" Classes="mono" FontSize="10" VerticalAlignment="Center" Text="{Binding MemberNotes}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button HorizontalAlignment="Left" Command="{Binding OpenSelectedConstellationMemberCommand}" Content="open selected integer →" />
              <Border Classes="inset" Padding="22">
                <StackPanel>
                  <TextBlock Classes="eyebrow" Text="PRIVATE NOTE" />
                  <TextBlock Classes="mono" TextWrapping="Wrap" Foreground="#8E91A0" Text="{Binding ActiveConstellation.PrivateNotes}" />
                </StackPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding ActiveConstellation.Citations}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="app:AuthoredCitationView">
                    <Border Classes="inset" Margin="0,0,0,7">
                      <StackPanel Spacing="3">
                        <TextBlock FontWeight="SemiBold" Text="{Binding SourceTitle}" />
                        <TextBlock Text="{Binding Label}" />
                        <TextBlock Classes="mono" FontSize="10" Text="{Binding Role}" />
                        <TextBlock Classes="mono" FontSize="10" Text="{Binding Locator}" />
                        <TextBlock Classes="mono" FontSize="10" Text="{Binding SourceCaptureId}" />
                        <TextBlock Classes="mono" FontSize="10" Foreground="#79B9AD" TextWrapping="Wrap" Text="{Binding SourceUrl}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Column="4" Classes="plate" Padding="14">
        <ScrollViewer>
          <StackPanel Spacing="12">
            <TextBlock Classes="eyebrow" Text="EPISTEMIC MARGIN / PRIVATE" />

            <StackPanel IsVisible="{Binding IsIntegerActive}" Spacing="12">

            <Expander IsExpanded="True" Header="new property claim draft">
              <StackPanel Margin="0,8,0,0" Spacing="7">
                <TextBox Text="{Binding DraftPropertySlug}" PlaceholderText="property slug" />
                <TextBox Text="{Binding DraftQualifierJson}" PlaceholderText="qualifier json" />
                <TextBox Text="{Binding DraftWitnessExpression}" PlaceholderText="friedman expression, when needed" />
                <TextBox MinHeight="62" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding DraftPrivateNotes}" PlaceholderText="private notes" />
                <WrapPanel Orientation="Horizontal">
                  <Button Margin="0,0,7,7" Command="{Binding CreateClaimDraftCommand}" Content="write private draft" />
                  <Button Margin="0,0,7,7" Command="{Binding LoadSelectedClaimDraftCommand}" Content="load selected draft" />
                  <Button Classes="accent" Margin="0,0,7,7" Command="{Binding SaveSelectedClaimDraftCommand}" Content="save draft edits" />
                </WrapPanel>
              </StackPanel>
            </Expander>

            <Expander Header="source &amp; citation bench">
              <StackPanel Margin="0,8,0,0" Spacing="7">
                <TextBox Text="{Binding SourceSlug}" PlaceholderText="source-slug" />
                <TextBox Text="{Binding SourceTitle}" PlaceholderText="source title" />
                <TextBox Text="{Binding SourceAuthor}" PlaceholderText="author / institution" />
                <TextBox Text="{Binding SourceUrl}" PlaceholderText="https://…" />
                <TextBox Text="{Binding SourceLicense}" PlaceholderText="license metadata" />
                <Button Command="{Binding CreateSourceCommand}" Content="create source" />
                <Border Height="1" Background="#2D303B" Margin="0,5" />
                <TextBox Text="{Binding CitationSourceId}" PlaceholderText="source id" />
                <TextBox Text="{Binding CitationLabel}" PlaceholderText="public citation label" />
                <TextBox Text="{Binding CitationRole}" PlaceholderText="role" />
                <TextBox Text="{Binding CitationLocator}" PlaceholderText="locator" />
                <CheckBox IsChecked="{Binding CitationPublicSafe}" Content="approve citation for public staging" />
                <Grid ColumnDefinitions="*,8,*">
                  <Button Command="{Binding CiteSelectedClaimCommand}" Content="cite claim" />
                  <Button Grid.Column="2" Command="{Binding CiteSelectedProfileCommand}" Content="cite profile" />
                </Grid>
              </StackPanel>
            </Expander>

            <Expander Header="new profile entry draft">
              <StackPanel Margin="0,8,0,0" Spacing="7">
                <TextBox Text="{Binding ProfileSlug}" PlaceholderText="entry-slug" />
                <TextBox Text="{Binding ProfileTitle}" PlaceholderText="title" />
                <TextBox Text="{Binding ProfileCategory}" PlaceholderText="category" />
                <TextBox Text="{Binding ProfileRegister}" PlaceholderText="epistemic register" />
                <TextBox MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding ProfileBody}" PlaceholderText="plain-text public-capable body" />
                <TextBox MinHeight="62" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding ProfilePrivateNotes}" PlaceholderText="private notes" />
                <WrapPanel Orientation="Horizontal">
                  <Button Margin="0,0,7,7" Command="{Binding CreateProfileDraftCommand}" Content="write profile draft" />
                  <Button Margin="0,0,7,7" Command="{Binding LoadSelectedProfileDraftCommand}" Content="load selected draft" />
                  <Button Classes="accent" Margin="0,0,7,7" Command="{Binding SaveSelectedProfileDraftCommand}" Content="save draft edits" />
                </WrapPanel>
              </StackPanel>
            </Expander>
            <Expander Header="new direct relation draft">
              <StackPanel Margin="0,8,0,0" Spacing="7">
                <TextBox Text="{Binding DirectRelationSlug}" PlaceholderText="stable relation slug" />
                <ComboBox ItemsSource="{Binding DirectionalityOptions}" SelectedItem="{Binding DirectRelationDirectionality}" />
                <Grid ColumnDefinitions="*,8,*">
                  <TextBox Text="{Binding DirectRelationFirstInteger}" PlaceholderText="first integer" />
                  <TextBox Grid.Column="2" Text="{Binding DirectRelationFirstRole}" PlaceholderText="first role" />
                </Grid>
                <Grid ColumnDefinitions="*,8,*">
                  <TextBox Text="{Binding DirectRelationSecondInteger}" PlaceholderText="second integer" />
                  <TextBox Grid.Column="2" Text="{Binding DirectRelationSecondRole}" PlaceholderText="second role" />
                </Grid>
                <TextBox Text="{Binding DirectRelationProposition}" PlaceholderText="rendered proposition" />
                <TextBox MinHeight="78" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding DirectRelationWarrant}" PlaceholderText="warrant / account" />
                <TextBox Text="{Binding DirectRelationRegister}" PlaceholderText="epistemic register" />
                <TextBox MinHeight="58" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding DirectRelationPrivateNotes}" PlaceholderText="private notes" />
                <Button Command="{Binding CreateDirectRelationDraftCommand}" Content="write direct-relation draft" />
              </StackPanel>
            </Expander>

            <Expander Header="new constellation draft">
              <StackPanel Margin="0,8,0,0" Spacing="7">
                <TextBox Text="{Binding ConstellationSlug}" PlaceholderText="stable constellation slug" />
                <TextBox Text="{Binding ConstellationName}" PlaceholderText="name" />
                <TextBox MinHeight="78" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding ConstellationAccount}" PlaceholderText="collective account" />
                <TextBox Text="{Binding ConstellationRegister}" PlaceholderText="epistemic register" />
                <TextBox MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding ConstellationMembers}" PlaceholderText="integer | role | optional note (one per line)" />
                <TextBox MinHeight="58" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding ConstellationPrivateNotes}" PlaceholderText="private notes" />
                <Button Command="{Binding CreateConstellationDraftCommand}" Content="write constellation draft" />
              </StackPanel>
            </Expander>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsDirectRelationActive}" Spacing="12">
              <Border Classes="inset">
                <StackPanel Spacing="6">
                  <TextBlock Classes="eyebrow" Text="DIRECT RELATION" />
                  <TextBlock Classes="mono" Text="{Binding ActiveDirectRelation.ActiveLabel}" />
                  <TextBlock Classes="mono" Text="{Binding ActiveDirectRelation.Revision, StringFormat='revision {0}'}" />
                  <TextBlock Classes="mono" Text="{Binding ActiveDirectRelation.SupersedesRevisionId, StringFormat='supersedes {0}'}" />
                  <TextBlock Classes="mono" Text="{Binding ActiveDirectRelation.EpistemicRegister}" TextWrapping="Wrap" />
                  <TextBlock Classes="mono" Text="{Binding ActiveDirectRelation.DirectionalityLabel}" />
                  <TextBlock Classes="mono" Text="{Binding ActiveDirectRelation.ParticipantLine}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Button IsVisible="{Binding IsActiveDirectRelationAccepted}" HorizontalAlignment="Left" Command="{Binding PrepareActiveDirectRelationRevisionCommand}" Content="prepare superseding draft" />
              <WrapPanel IsVisible="{Binding IsActiveDirectRelationDraft}">
                <Button Margin="0,0,7,7" Command="{Binding LoadActiveDirectRelationDraftCommand}" Content="reload draft" />
                <Button Margin="0,0,7,7" Command="{Binding AcceptActiveDirectRelationCommand}" Content="accept" />
                <Button Margin="0,0,7,7" Command="{Binding WithdrawActiveDirectRelationCommand}" Content="withdraw" />
              </WrapPanel>
              <StackPanel IsVisible="{Binding IsActiveDirectRelationDraft}" Spacing="12">
              <TextBox IsReadOnly="True" Text="{Binding DirectRelationSlug}" PlaceholderText="stable relation slug" />
              <ComboBox ItemsSource="{Binding DirectionalityOptions}" SelectedItem="{Binding DirectRelationDirectionality}" />
              <Grid ColumnDefinitions="*,8,*">
                <TextBox Text="{Binding DirectRelationFirstInteger}" PlaceholderText="first integer" />
                <TextBox Grid.Column="2" Text="{Binding DirectRelationFirstRole}" PlaceholderText="first role" />
              </Grid>
              <Grid ColumnDefinitions="*,8,*">
                <TextBox Text="{Binding DirectRelationSecondInteger}" PlaceholderText="second integer" />
                <TextBox Grid.Column="2" Text="{Binding DirectRelationSecondRole}" PlaceholderText="second role" />
              </Grid>
              <TextBox Text="{Binding DirectRelationProposition}" PlaceholderText="proposition" />
              <TextBox MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding DirectRelationWarrant}" PlaceholderText="warrant" />
              <TextBox Text="{Binding DirectRelationRegister}" PlaceholderText="epistemic register" />
              <TextBox MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding DirectRelationPrivateNotes}" PlaceholderText="private notes" />
              <Button Classes="accent" Command="{Binding SaveActiveDirectRelationDraftCommand}" Content="save draft aggregate" />
              <Expander Header="cite this draft">
                <StackPanel Margin="0,8,0,0" Spacing="7">
                  <TextBox Text="{Binding CitationSourceId}" PlaceholderText="source id" />
                  <TextBox Text="{Binding CitationCaptureId}" PlaceholderText="optional capture id" />
                  <TextBox Text="{Binding CitationLabel}" PlaceholderText="citation label" />
                  <TextBox Text="{Binding CitationRole}" PlaceholderText="role" />
                  <TextBox Text="{Binding CitationLocator}" PlaceholderText="locator" />
                  <Button Command="{Binding CiteActiveDirectRelationCommand}" Content="attach citation" />
                </StackPanel>
              </Expander>
              </StackPanel>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsConstellationActive}" Spacing="12">
              <Border Classes="inset">
                <StackPanel Spacing="6">
                  <TextBlock Classes="eyebrow" Text="CONSTELLATION" />
                  <TextBlock Classes="mono" Text="{Binding ActiveConstellation.ActiveLabel}" />
                  <TextBlock Classes="mono" Text="{Binding ActiveConstellation.Revision, StringFormat='revision {0}'}" />
                  <TextBlock Classes="mono" Text="{Binding ActiveConstellation.SupersedesRevisionId, StringFormat='supersedes {0}'}" />
                  <TextBlock Classes="mono" Text="{Binding ActiveConstellation.EpistemicRegister}" TextWrapping="Wrap" />
                  <TextBlock Classes="mono" Text="{Binding ActiveConstellation.MemberLine}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Button IsVisible="{Binding IsActiveConstellationAccepted}" HorizontalAlignment="Left" Command="{Binding PrepareActiveConstellationRevisionCommand}" Content="prepare superseding draft" />
              <WrapPanel IsVisible="{Binding IsActiveConstellationDraft}">
                <Button Margin="0,0,7,7" Command="{Binding LoadActiveConstellationDraftCommand}" Content="reload draft" />
                <Button Margin="0,0,7,7" Command="{Binding AcceptActiveConstellationCommand}" Content="accept" />
                <Button Margin="0,0,7,7" Command="{Binding WithdrawActiveConstellationCommand}" Content="withdraw" />
              </WrapPanel>
              <StackPanel IsVisible="{Binding IsActiveConstellationDraft}" Spacing="12">
              <TextBox IsReadOnly="True" Text="{Binding ConstellationSlug}" PlaceholderText="stable constellation slug" />
              <TextBox Text="{Binding ConstellationName}" PlaceholderText="name" />
              <TextBox MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding ConstellationAccount}" PlaceholderText="collective account" />
              <TextBox Text="{Binding ConstellationRegister}" PlaceholderText="epistemic register" />
              <TextBox MinHeight="110" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding ConstellationMembers}" PlaceholderText="integer | role | optional note" />
              <TextBox MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding ConstellationPrivateNotes}" PlaceholderText="private notes" />
              <Button Classes="accent" Command="{Binding SaveActiveConstellationDraftCommand}" Content="save collective draft" />
              <Expander Header="cite this draft">
                <StackPanel Margin="0,8,0,0" Spacing="7">
                  <TextBox Text="{Binding CitationSourceId}" PlaceholderText="source id" />
                  <TextBox Text="{Binding CitationCaptureId}" PlaceholderText="optional capture id" />
                  <TextBox Text="{Binding CitationLabel}" PlaceholderText="citation label" />
                  <TextBox Text="{Binding CitationRole}" PlaceholderText="role" />
                  <TextBox Text="{Binding CitationLocator}" PlaceholderText="locator" />
                  <Button Command="{Binding CiteActiveConstellationCommand}" Content="attach citation" />
                </StackPanel>
              </Expander>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#0C0D12" BorderBrush="#2B2E38" BorderThickness="0,1,0,0">
      <TextBlock Margin="18,0" VerticalAlignment="Center" Classes="mono" FontSize="11" Text="{Binding StatusMessage}" />
    </Border>
  </Grid>
</Window>
